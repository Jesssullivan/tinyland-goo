"""
Root BUILD.bazel for tinyland-goo.

Minimal, toolchain-only. The SvelteKit static site is built by `pnpm run build`
(never Bazel); Bazel owns only a finite graphable check target so module-graph
integrity is provable. The unit-test target + vitest land in a later phase.
"""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:vitest/package_json.bzl", vitest = "bin")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "app_srcs",
    srcs = glob(
        [
            "src/**",
            "static/**",
            "scripts/bazel/**/*.mjs",
        ],
        allow_empty = True,
    ) + [
        ".npmrc",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
)

js_binary(
    name = "sveltekit_sync_bin",
    data = [":node_modules"],
    entry_point = "scripts/bazel/run-sveltekit-sync.mjs",
)

# SvelteKit 3 `svelte-kit sync` writes route types under .svelte-kit and the
# parent tsconfig plus `$app/types` under node_modules/$app (tsconfig.json
# extends "$app/tsconfig"); both trees are declared outputs.
js_run_binary(
    name = "sveltekit_types",
    srcs = [":app_srcs"],
    out_dirs = [
        ".svelte-kit",
        "node_modules/$app",
    ],
    tags = ["flywheel-eligible"],
    tool = ":sveltekit_sync_bin",
)

# Sources plus the generated SvelteKit types as one declared tree, so the
# type check can copy it into writable scratch (svelte-check --tsgo writes
# its transpiled components under .svelte-check).
copy_to_directory(
    name = "app_workspace",
    srcs = [
        ":app_srcs",
        ":sveltekit_types",
    ],
    hardlink = "off",
    root_paths = ["."],
)

# TypeScript 7.0.2 (RU13) checks through svelte-check's native mode (`--tsgo`)
# on a writable scratch copy of :app_workspace.
js_test(
    name = "svelte_check_test",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
    ],
    data = [
        ":app_workspace",
        ":node_modules",
        "scripts/bazel/prepare-sveltekit-types.mjs",
    ],
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    tags = ["flywheel-eligible"],
    timeout = "long",
)

# Seeded-error canary: fails unless svelte-check --tsgo reports a seeded .ts
# and .svelte type error (a tsconfig that checks nothing reports 0 errors
# under --tsgo, sveltejs/language-tools#3136).
js_test(
    name = "svelte_check_canary_test",
    args = [
        "--workspace",
        "$(rootpath :app_workspace)",
        "--canary",
    ],
    data = [
        ":app_workspace",
        ":node_modules",
        "scripts/bazel/prepare-sveltekit-types.mjs",
    ],
    entry_point = "scripts/bazel/run-svelte-check.mjs",
    tags = ["flywheel-eligible"],
    timeout = "long",
)

write_file(
    name = "test_lib_tsconfig",
    out = "src/lib/tsconfig.json",
    content = [
        "{",
        "  \"compilerOptions\": {",
        "    \"target\": \"ES2022\",",
        "    \"module\": \"ESNext\",",
        "    \"moduleResolution\": \"bundler\",",
        "    \"esModuleInterop\": true,",
        "    \"resolveJsonModule\": true,",
        "    \"strict\": true,",
        "    \"skipLibCheck\": true",
        "  }",
        "}",
    ],
)

vitest.vitest_test(
    name = "unit_tests",
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    data = [
        ":app_srcs",
        ":node_modules",
        ":node_modules/vitest",
        ":test_lib_tsconfig",
        "vitest.config.ts",
    ],
    tags = [
        "flywheel-eligible",
        "vitest",
    ],
    visibility = ["//visibility:public"],
)

# BUILD-authority RBE target: Bazel runs `svelte-kit sync` + `vite build` as a
# remotely-executable action (the executor lane exercises this). The canonical
# Pages publish still runs `pnpm run build` — this is the Bazel-SSOT build proof,
# never the deploy path. Tagged gloriousflywheel-rbe-candidate to mirror the fleet.
js_test(
    name = "sveltekit_vite_build_smoke",
    data = [
        ":app_srcs",
        ":node_modules",
        "scripts/bazel/prepare-sveltekit-types.mjs",
    ],
    entry_point = "scripts/bazel/run-sveltekit-vite-build.mjs",
    tags = [
        "flywheel-eligible",
        "gloriousflywheel-rbe-candidate",
        "web-build-runtime-authority",
    ],
    timeout = "long",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "ci_validation_suite",
    # A test_suite's tags are a positive FILTER over members (all carry
    # flywheel-eligible), keeping it under the flywheel-executor tag filter. Do
    # NOT add "manual" — it would drop the members and resolve to zero targets.
    tags = ["flywheel-eligible"],
    tests = [
        ":svelte_check_canary_test",
        ":svelte_check_test",
        ":sveltekit_vite_build_smoke",
        ":unit_tests",
    ],
)

exports_files(
    [
        "MODULE.bazel",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "vite.config.ts",
    ],
    visibility = ["//visibility:public"],
)
