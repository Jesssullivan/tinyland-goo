"""
tinyland-goo - Bazel Module Configuration

TOOLCHAIN-ONLY module-graph integrity proof. The canonical site build is
`pnpm run build` (adapter-static -> GitHub Pages) and is NEVER on the Bazel
critical path. Bazel exists here only so `bazelisk mod graph` proves the
dependency/toolchain graph resolves against an immutable-pinned
tinyland-inc/bazel-registry ref + BCR. See AGENTS.md.

This leaf has 0 production deps, so the @tummycrypt/* building-block modules the
fuller scaffold pulls are intentionally NOT depended on here (decision: keep the
graph toolchain-only; the inhouse-package-parity gate is therefore dropped). Add
a @tummycrypt bazel_dep only if a vendored asset genuinely imports it.
"""

module(
    name = "tinyland_goo",
    version = "0.1.0",
    compatibility_level = 1,
)

# Core
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_pkg", version = "1.1.0")

# JS/TS toolchain (Aspect)
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_rules_js", version = "2.9.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "aspect_rules_swc", version = "2.6.1")

# Node 22.22.0 (SvelteKit 3 requires Node >= 22.17)
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.22.0")

# pnpm 10.13.1
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.13.1",
)
use_repo(pnpm, "pnpm")

# npm via pnpm-lock.yaml. Repo name "npm" matches the Aspect convention.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    # RU13 patch set (copied from site.scaffold patches/): npm_translate_lock
    # applies the pnpm patchedDependencies recorded in pnpm-lock.yaml.
    data = [
        "//:.pnpmfile.cjs",
        "//:package.json",
        "//:patches/@sveltejs__kit@3.0.1.patch",
        "//:patches/devalue@5.9.4.patch",
        "//:patches/svelte-check@4.7.6.patch",
        "//:pnpm-workspace.yaml",
    ],
)
use_repo(npm, "npm")

# TypeScript 7.0.2 (RU13), matching package.json `typescript` exactly.
typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version = "7.0.2")
use_repo(typescript, "npm_typescript")

# SWC for any future ts_project targets
swc = use_extension("@aspect_rules_swc//swc:extensions.bzl", "swc")
swc.toolchain(
    name = "swc",
    swc_version = "v1.10.12",
)
use_repo(swc, "swc_toolchains")

register_toolchains("@swc_toolchains//:all")
