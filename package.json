{
	"name": "tinyland-goo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Tinyland static lab notebook for UV-reactive 3D-printer bed glue plus paraffin wax research tracks for bike chain wax and hair removal wax.",
	"homepage": "https://jesssullivan.github.io/tinyland-goo/",
	"repository": {
		"type": "git",
		"url": "https://github.com/Jesssullivan/tinyland-goo.git"
	},
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": "^22.17.0 || >=24 <25"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@fontsource/inter": "^5.3.0",
		"@skeletonlabs/skeleton": "5.0.1",
		"@skeletonlabs/skeleton-svelte": "5.0.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.1",
		"@typescript/typescript6": "6.0.2",
		"@vitest/coverage-v8": "5.0.3",
		"rollup-plugin-visualizer": "^7.0.1",
		"sharp": "^0.35.3",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svgo": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	},
	"pnpm": {
		"overrides": {
			"vite": "8.3.3"
		},
		"packageExtensions": {
			"@sveltejs/kit@3.0.1": {
				"peerDependencies": {
					"@typescript/typescript6": "^6.0.0"
				},
				"peerDependenciesMeta": {
					"@typescript/typescript6": {
						"optional": true
					}
				}
			}
		},
		"peerDependencyRules": {
			"allowedVersions": {
				"@sveltejs/kit>typescript": "7"
			}
		},
		"patchedDependencies": {
			"@sveltejs/kit@3.0.1": "patches/@sveltejs__kit@3.0.1.patch",
			"devalue@5.9.4": "patches/devalue@5.9.4.patch",
			"svelte-check@4.7.6": "patches/svelte-check@4.7.6.patch"
		},
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"sharp"
		]
	}
}
